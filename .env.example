# API configuration
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# Frontend configuration (copy to apps/web/.env when needed)
VITE_API_BASE_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000

# PostgreSQL configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gridd_dashboard
DATABASE_USER=gridd
DATABASE_PASSWORD=

# Observation simulator (disabled by default)
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_MS=5000

# Kafka GRIDD consumer (disabled by default; credentials must stay local)
KAFKA_ENABLED=false
KAFKA_BROKERS=kafka.gridd-dt.ca:9096
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT_PATH=
KAFKA_GROUP_ID=gridd-smart-environment-dashboard
KAFKA_RECONNECT_INTERVAL_MS=5000

# Comfort and alert thresholds (application defaults, not regulatory standards)
TEMPERATURE_WARNING_MIN=18
TEMPERATURE_NORMAL_MIN=20
TEMPERATURE_NORMAL_MAX=25
TEMPERATURE_WARNING_MAX=28
HUMIDITY_WARNING_MIN=20
HUMIDITY_NORMAL_MIN=30
HUMIDITY_NORMAL_MAX=60
HUMIDITY_WARNING_MAX=70
CO2_NORMAL_MAX=800
CO2_WARNING_MAX=1200
SOUND_LEVEL_NORMAL_MAX=55
SOUND_LEVEL_WARNING_MAX=70

# Comfort Index weights (normalized at runtime)
COMFORT_WEIGHT_TEMPERATURE=0.3
COMFORT_WEIGHT_HUMIDITY=0.2
COMFORT_WEIGHT_CO2=0.3
COMFORT_WEIGHT_NOISE=0.2
COMFORT_STATUS_GOOD_MIN=80
COMFORT_STATUS_WARNING_MIN=50

