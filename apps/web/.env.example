# ---------------------------------------------------------------------------
# Frontend GRIDD — variables d'environnement
# Tout ce qui est transmis au navigateur est PUBLIC : aucun secret ici.
# ---------------------------------------------------------------------------

# --- Exécution (serveur Node / Docker), lues au démarrage -------------------
# Adresse de l'API vue par le navigateur. Vide = même origine que le frontend
# (utile derrière un reverse proxy qui relaie /api et /ws).
GRIDD_API_URL=http://localhost:8000
# Adresse WebSocket. Vide = déduite de GRIDD_API_URL (http→ws, https→wss).
GRIDD_WS_URL=
# Port d'écoute du serveur Node et port publié par Docker Compose.
PORT=3000
WEB_PORT=3000
# Journaliser chaque requête HTTP (true/false).
LOG_REQUESTS=false

# --- Développement (npm run dev) -------------------------------------------
# API vers laquelle Vite relaie /api et /ws.
VITE_DEV_API_PROXY=http://127.0.0.1:8000
# Valeurs de repli intégrées au bundle à la compilation (facultatif).
# La configuration d'exécution (GRIDD_API_URL) est prioritaire.
VITE_API_URL=
VITE_WS_URL=
