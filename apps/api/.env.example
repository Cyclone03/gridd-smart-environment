# ---------------------------------------------------------------------------
# API GRIDD — copier en .env et adapter. Ne jamais versionner .env.
# ---------------------------------------------------------------------------

# Obligatoire si DEBUG=false. Générer par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=America/Toronto
LOG_LEVEL=INFO

# Origines du frontend autorisées (CORS et WebSocket), séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Origines HTTPS de confiance pour l'admin Django (ex. https://api.example.org).
CSRF_TRUSTED_ORIGINS=
# Derrière un proxy TLS qui transmet X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=false

# --- Base de données --------------------------------------------------------
# sqlite (défaut, fichier db.sqlite3) ou postgres
DB_ENGINE=postgres
DB_NAME=gridd
DB_USER=gridd
DB_PASSWORD=gridd_dev
# Exécution hors Docker : PostgreSQL publié par docker-compose.yml sur 5433
DB_HOST=localhost
DB_PORT=5433

# --- Temps réel (Django Channels) --------------------------------------------
# Vide : couche en mémoire, limitée à un seul processus (tests uniquement).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Docker Compose (adresses vues depuis les conteneurs) ---------------------
# Laisser vides pour utiliser les services postgres/redis/kafka du Compose.
CONTAINER_DB_HOST=
CONTAINER_DB_PORT=
CONTAINER_REDIS_URL=
CONTAINER_KAFKA_BOOTSTRAP_SERVERS=
API_PORT=8000

# --- Périodes d'analyse (historique, confort, énergie) ---------------------
HISTORY_MAX_RANGE_DAYS=31
HISTORY_TARGET_POINTS=400
HISTORY_MAX_POINTS=3000

# --- Bus d'événements (Kafka) ------------------------------------------------
# Les modules communiquent uniquement par Kafka (voir docs/events.md).
#   memory : bus synchrone dans le processus — développement sans Kafka, tests.
#   kafka  : production — lancer aussi « python manage.py run_consumers ».
EVENT_BUS=memory

# Bus interne des modules. Hors Docker : Kafka du docker-compose publié sur 9094.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT_PATH=

# Topics capteurs lus sur un autre cluster (Kafka GRIDD). Vide = bus interne.
# Exemple GRIDD : kafka.gridd-dt.ca:9096, SASL_SSL, identifiants et certificat CA
# (dans Docker : /app/secrets/gridd-kafka-ca.crt ; hors Docker : chemin absolu).
KAFKA_SENSORS_BOOTSTRAP_SERVERS=
KAFKA_SENSORS_SECURITY_PROTOCOL=
KAFKA_SENSORS_SASL_MECHANISM=
KAFKA_SENSORS_USERNAME=
KAFKA_SENSORS_PASSWORD=
KAFKA_SENSORS_CA_CERT_PATH=

# Topics capteurs (entrée du système)
KAFKA_TOPIC_TEMPERATURE=gridd.obs.environmental.temperature
KAFKA_TOPIC_HUMIDITY=gridd.obs.environmental.humidity
KAFKA_TOPIC_CO2=gridd.obs.environmental.co2
KAFKA_TOPIC_SOUND=gridd.obs.acoustic.sound_level
KAFKA_TOPIC_OCCUPANCY=gridd.obs.occupancy.count

# Topics de sortie des modules
KAFKA_TOPIC_INGESTION_OBSERVATIONS=gridd.backend.ingestion.observations
KAFKA_TOPIC_ALARMS_EVENTS=gridd.backend.alarms.events
KAFKA_TOPIC_ALARMS_COMMANDS=gridd.backend.alarms.commands
KAFKA_TOPIC_COMFORT_EVENTS=gridd.backend.comfort.events
KAFKA_TOPIC_COMFORT_COMMANDS=gridd.backend.comfort.commands
KAFKA_TOPIC_ENERGY_EVENTS=gridd.backend.energy.events
KAFKA_TOPIC_ENERGY_COMMANDS=gridd.backend.energy.commands
KAFKA_TOPIC_DATABASE_EVENTS=gridd.backend.database.events
KAFKA_TOPIC_DATABASE_REPLIES=gridd.backend.database.replies

# Topics persistés par le module Database (séparés par des virgules).
# Vide = topics de sortie des modules ingestion, alarms, comfort et energy.
DATABASE_SUBSCRIBED_TOPICS=

# Consommation : un consumer group par module, « <préfixe>.<module> ».
KAFKA_CONSUMER_GROUP_PREFIX=gridd-backend
KAFKA_MAX_ATTEMPTS=5
KAFKA_RETRY_DELAY_SECONDS=2
# Délai de réponse aux commandes de l'API (règles d'alarme, connexion).
KAFKA_COMMAND_TIMEOUT_SECONDS=10
# Création des topics internes manquants au démarrage de run_consumers.
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# --- Confort thermique et énergie --------------------------------------------
# Âge maximal de la mesure complémentaire (ex. humidité lors d'une température).
COMFORT_MAX_INPUT_AGE_MINUTES=30
ENERGY_MAX_INPUT_AGE_MINUTES=30
# Au-delà de cet écart entre deux mesures, l'intervalle n'est pas estimé.
ENERGY_MAX_INTERVAL_MINUTES=15
