# ---------------------------------------------------------------------------
# API GRIDD — copier en .env et adapter. Ne jamais versionner .env.
# ---------------------------------------------------------------------------

# Obligatoire si DEBUG=false. Générer par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=America/Toronto
LOG_LEVEL=INFO

# Origines du frontend autorisées (CORS et WebSocket), séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Origines HTTPS de confiance pour l'admin Django (ex. https://api.example.org).
CSRF_TRUSTED_ORIGINS=
# Derrière un proxy TLS qui transmet X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=false

# --- Base de données --------------------------------------------------------
# sqlite (défaut, fichier db.sqlite3) ou postgres
DB_ENGINE=postgres
DB_NAME=gridd
DB_USER=gridd
DB_PASSWORD=gridd_dev
# Exécution hors Docker : PostgreSQL publié par docker-compose.yml sur 5433
DB_HOST=localhost
DB_PORT=5433

# --- Temps réel (Django Channels) --------------------------------------------
# Vide : couche en mémoire, limitée à un seul processus (tests uniquement).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Adresses depuis les conteneurs Docker -----------------------------------
# Configurer les variables DB_*, REDIS_URL et KAFKA_* ci-dessous avec des
# adresses accessibles depuis les conteneurs. « localhost » désigne le conteneur.
API_PORT=8000

# --- Périodes d'analyse historique -----------------------------------------
HISTORY_MAX_RANGE_DAYS=31
HISTORY_TARGET_POINTS=400
HISTORY_MAX_POINTS=3000

# --- Temps réel (/ws/dashboard/) ---------------------------------------------
# Historique des alertes résolues envoyé avec les alertes actives.
REALTIME_ALERT_HISTORY_DAYS=7
REALTIME_ALERT_HISTORY_LIMIT=50

# --- Bus d'événements (Kafka) ------------------------------------------------
# Les modules communiquent uniquement par Kafka (voir docs/events.md).
#   memory : bus synchrone dans le processus — développement sans Kafka, tests.
#   kafka  : production — lancer aussi « python manage.py run_consumers ».
EVENT_BUS=memory

# Bus interne des modules. Hors Docker : Kafka du docker-compose publié sur 9094.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT_PATH=

# Topics capteurs lus sur un autre cluster (Kafka GRIDD). Vide = bus interne.
# Exemple GRIDD : kafka.gridd-dt.ca:9096, SASL_SSL, identifiants et certificat CA
# (dans Docker : /app/secrets/gridd-kafka-ca.crt ; hors Docker : chemin absolu).
KAFKA_SENSORS_BOOTSTRAP_SERVERS=
KAFKA_SENSORS_SECURITY_PROTOCOL=
KAFKA_SENSORS_SASL_MECHANISM=
KAFKA_SENSORS_USERNAME=
KAFKA_SENSORS_PASSWORD=
KAFKA_SENSORS_CA_CERT_PATH=

# Nœuds GRIDD qui n'annoncent pas leur zone dans leurs messages (metadata.zone) :
# correspondance « nœud=code de zone », séparée par des virgules. Sans zone
# connue, la mesure est rejetée (« zone absente ») au lieu de créer un espace
# nommé d'après le nœud. Ex. : node01=individual-work-cubicle-01,node02=meeting-room
GRIDD_NODE_ZONES=

# Topics capteurs (entrée du système)
KAFKA_TOPIC_TEMPERATURE=gridd.obs.environmental.temperature
KAFKA_TOPIC_HUMIDITY=gridd.obs.environmental.humidity
KAFKA_TOPIC_CO2=gridd.obs.environmental.co2
KAFKA_TOPIC_SOUND=gridd.obs.acoustic.sound_level
KAFKA_TOPIC_OCCUPANCY=gridd.obs.occupancy.count

# Topics de sortie des modules
KAFKA_TOPIC_INGESTION_OBSERVATIONS=gridd.backend.ingestion.observations
KAFKA_TOPIC_ALARMS_EVENTS=gridd.backend.alarms.events
KAFKA_TOPIC_ALARMS_COMMANDS=gridd.backend.alarms.commands
KAFKA_TOPIC_DATABASE_EVENTS=gridd.backend.database.events
KAFKA_TOPIC_DATABASE_REPLIES=gridd.backend.database.replies

# Topics persistés par le module Database (séparés par des virgules).
# Vide = topics de sortie des modules ingestion et alarms.
DATABASE_SUBSCRIBED_TOPICS=

# Consommation : un consumer group par module, « <préfixe>.<module> ».
# UNIQUE PAR DÉPLOIEMENT : deux backends avec le même préfixe sur le même Kafka
# se partagent les partitions, donc les zones (voir docs/deployment.md).
KAFKA_CONSUMER_GROUP_PREFIX=gridd-backend
KAFKA_MAX_ATTEMPTS=5
KAFKA_RETRY_DELAY_SECONDS=2
# Messages traités par lot : publications confirmées et offsets validés une
# fois par lot (un aller-retour broker par lot au lieu de deux par message).
KAFKA_BATCH_SIZE=500
# Messages préchargés par partition. Petit : une partition en rattrapage ne
# retarde plus les messages récents des autres partitions (zones à jour).
KAFKA_PREFETCH_MESSAGES=1000
# Module bloqué plus longtemps que ce délai : arrêt du processus (Docker le
# redémarre). Battement de cœur pour le healthcheck du service kafka-consumer.
KAFKA_CONSUMER_STALL_SECONDS=300
KAFKA_CONSUMER_HEARTBEAT_FILE=/tmp/gridd-consumers.heartbeat
# /api/health/ passe à « degraded » si aucune mesure depuis ce délai (s).
HEALTH_MAX_DATA_AGE_SECONDS=600

# --- WebSocket (channels_redis) -----------------------------------------------
# Messages en attente par connexion avant rejet.
CHANNEL_CAPACITY=500
# Inscription d'une connexion à un groupe, renouvelée par le ping du
# navigateur (25 s) : une connexion morte disparaît après ce délai.
CHANNEL_GROUP_EXPIRY_SECONDS=120
# Délai de réponse aux commandes de l'API (règles d'alarme, connexion).
KAFKA_COMMAND_TIMEOUT_SECONDS=10
# Création des topics internes manquants au démarrage de run_consumers.
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# --- Module IA (service ai-prediction, image Docker « ia ») -------------------
# Lu uniquement par « python manage.py run_ai_predictions ». Le service publie
# sur le bus interne ci-dessus (KAFKA_*, pas KAFKA_SENSORS_*) ; le module
# Database persiste les prédictions (topic KAFKA_TOPIC_AI_PREDICTIONS).
KAFKA_TOPIC_AI_PREDICTIONS=gridd.backend.ai_prediction.events
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
# Les 12 empreintes scaler_x/scaler_y du manifeste, après revue de provenance
# (voir modules/ia/README.md). Vide : aucun modèle chargé, météo seule.
AI_APPROVED_SCALER_SHA256=
AI_PREDICTION_INTERVAL_SECONDS=3600
AI_PREDICTION_HEARTBEAT_INTERVAL_SECONDS=30
AI_PREDICTION_HEARTBEAT_MAX_AGE_SECONDS=180
# Cycles alignés sur les quarts d'heure d'Open-Meteo + 60 s (HH:01, HH:16…).
AI_PREDICTION_ALIGN_SECONDS=900
AI_PREDICTION_ALIGN_OFFSET_SECONDS=60
# Dossier d'état (registre SQLite des publications, battement de cœur) et
# confirmation d'environnement isolé : fixés par l'image « ia » et le
# docker-compose (/var/lib/ai-predictions, volume ai-prediction-state). Hors
# Docker uniquement :
# AI_STATE_DIR=./state
# AI_ISOLATED_ENVIRONMENT=true
# database : lecture directe des dernières mesures ; api : API REST GRIDD.
AI_OBSERVATION_SOURCE=database
GRIDD_API_BASE_URL=http://api:8000
OPEN_METEO_LATITUDE=45.5088
OPEN_METEO_LONGITUDE=-73.5878
AI_HTTP_TIMEOUT_SECONDS=10
