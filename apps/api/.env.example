DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL et Redis fournis par docker-compose.yml
DB_ENGINE=postgres
DB_NAME=gridd
DB_USER=gridd
DB_PASSWORD=gridd_dev
DB_HOST=localhost
DB_PORT=5433
REDIS_URL=redis://127.0.0.1:6379/0

# Kafka GRIDD
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka.gridd-dt.ca:9096
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT_PATH=
KAFKA_GROUP_ID=gridd-django-dashboard
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# Topics
KAFKA_TOPIC_TEMPERATURE=gridd.obs.environmental.temperature
KAFKA_TOPIC_HUMIDITY=gridd.obs.environmental.humidity
KAFKA_TOPIC_CO2=gridd.obs.environmental.co2
KAFKA_TOPIC_SOUND=gridd.obs.acoustic.sound_level
KAFKA_TOPIC_OCCUPANCY=gridd.obs.occupancy.count
