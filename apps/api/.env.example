# ---------------------------------------------------------------------------
# API GRIDD — copier en .env et adapter. Ne jamais versionner .env.
# ---------------------------------------------------------------------------

# Obligatoire si DEBUG=false. Générer par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=America/Toronto
LOG_LEVEL=INFO

# Origines du frontend autorisées (CORS et WebSocket), séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Origines HTTPS de confiance pour l'admin Django (ex. https://api.example.org).
CSRF_TRUSTED_ORIGINS=
# Derrière un proxy TLS qui transmet X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=false

# --- Base de données --------------------------------------------------------
# sqlite (défaut, fichier db.sqlite3) ou postgres
DB_ENGINE=postgres
DB_NAME=gridd
DB_USER=gridd
DB_PASSWORD=gridd_dev
# Exécution hors Docker : PostgreSQL publié par docker-compose.yml sur 5433
DB_HOST=localhost
DB_PORT=5433

# --- Temps réel (Django Channels) --------------------------------------------
# Vide : couche en mémoire, limitée à un seul processus (tests uniquement).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Docker Compose (adresses vues depuis les conteneurs) ---------------------
# Laisser vides pour utiliser les services postgres/redis du Compose.
CONTAINER_DB_HOST=
CONTAINER_DB_PORT=
CONTAINER_REDIS_URL=
API_PORT=8000

# --- Authentification et API -------------------------------------------------
AUTH_TOKEN_TTL_HOURS=12
LOGIN_THROTTLE_RATE=10/min
HISTORY_MAX_RANGE_DAYS=31
HISTORY_TARGET_POINTS=400
HISTORY_MAX_POINTS=3000

# --- Kafka GRIDD -------------------------------------------------------------
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka.gridd-dt.ca:9096
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Hors Docker : chemin absolu. Dans Docker : fixé à /app/secrets/gridd-kafka-ca.crt
KAFKA_CA_CERT_PATH=
KAFKA_GROUP_ID=gridd-django-dashboard
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

KAFKA_TOPIC_TEMPERATURE=gridd.obs.environmental.temperature
KAFKA_TOPIC_HUMIDITY=gridd.obs.environmental.humidity
KAFKA_TOPIC_CO2=gridd.obs.environmental.co2
KAFKA_TOPIC_SOUND=gridd.obs.acoustic.sound_level
KAFKA_TOPIC_OCCUPANCY=gridd.obs.occupancy.count
