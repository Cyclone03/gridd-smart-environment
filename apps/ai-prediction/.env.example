# ---------------------------------------------------------------------------
# Service de prédiction IA — copier en .env (lu par docker-compose.yml).
# Ne jamais versionner .env : il contient les accès Kafka.
# ---------------------------------------------------------------------------

# --- Modèles ------------------------------------------------------------------
AI_ARTIFACT_MANIFEST_PATH=/app/artifacts/manifest.json
# Les 12 empreintes scaler_x/scaler_y du manifeste, après revue de provenance
# (voir README, section Dépannage). Vide = aucun modèle chargé.
AI_APPROVED_SCALER_SHA256=
AI_ISOLATED_ENVIRONMENT=true

# --- Planification et état local ----------------------------------------------
AI_PREDICTION_INTERVAL_SECONDS=3600
AI_PREDICTION_HEARTBEAT_INTERVAL_SECONDS=30
AI_PREDICTION_HEARTBEAT_MAX_AGE_SECONDS=180
AI_PREDICTION_HEARTBEAT_PATH=/var/lib/ai-predictions/heartbeat
AI_PREDICTION_LEDGER_PATH=/var/lib/ai-predictions/predictions.sqlite3

# --- Sources de données -------------------------------------------------------
GRIDD_API_BASE_URL=http://api:8000
OPEN_METEO_LATITUDE=45.5088
OPEN_METEO_LONGITUDE=-73.5878
HTTP_TIMEOUT_SECONDS=10

# --- Bus interne des modules (Kafka) ------------------------------------------
# Même bus que le service « consumers » de Django, qui lit le topic ci-dessous.
# Ne pas utiliser ici le cluster des capteurs (KAFKA_SENSORS_*, kafka.gridd-dt.ca:9096).
# Dans Docker : kafka:9092. Hors Docker : localhost:19092 (port publié par le
# docker-compose.yml racine).
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Utilisés seulement avec SASL_PLAINTEXT / SASL_SSL ; le certificat CA avec SSL / SASL_SSL.
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT_PATH=
KAFKA_TOPIC_AI_PREDICTIONS=gridd.backend.ai_prediction.events
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
