{
  "name": "gridd-smart-environment",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev:api": "pnpm --filter @gridd/api start:dev",
    "build:api": "pnpm --filter @gridd/api build",
    "test:api": "pnpm --filter @gridd/api test",
    "dev:web": "pnpm --filter @gridd/web dev",
    "build:web": "pnpm --filter @gridd/web build",
    "test:web": "pnpm --filter @gridd/web test",
    "migration:run": "pnpm --filter @gridd/api migration:run",
    "migration:revert": "pnpm --filter @gridd/api migration:revert"
  }
}
